# Copy to backend/.env (git-ignored) and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Optional ---------------------------------------------------------------
# Comma-separated OpenRouter model ids that sit at the round table (1-26).
# Free models come and go; browse https://openrouter.ai/models?max_price=0
# COUNCIL_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free
# The chairman writes the final ruling.
# CHAIRMAN_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Parallel requests to OpenRouter (lower this if you hit rate limits).
# MAX_CONCURRENT_REQUESTS=3
# REQUEST_TIMEOUT_SECONDS=90
# MAX_RETRIES=3
# MAX_PROMPT_CHARS=8000
# Comma-separated browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173
